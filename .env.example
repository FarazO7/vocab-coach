# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.
# Names only here. Defaults (used when a non-secret value is left empty) are in comments.

# Secrets
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# 32+ random bytes, e.g. `openssl rand -base64 32`
SESSION_SECRET=

# LLM (default: gpt-6-luna)
LLM_MODEL=
# none | low | medium | high (default: none)
LLM_REASONING_EFFORT=

# Speech-to-text (defaults: nova-3, en-IN)
STT_MODEL=
STT_LANGUAGE=

# Text-to-speech: one of aura-2-draco-en, aura-2-pandora-en, aura-2-harmonia-en (choice pending)
TTS_VOICE=

# Kill switch: false disables /api/stt and /api/tts (default: true)
VOICE_ENABLED=
